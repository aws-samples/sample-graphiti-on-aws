# =============================================================================
# Graphiti agent memory — AWS China regions, models via LiteLLM proxy
# =============================================================================
# On ECS these are injected by the CDK stack; this file is for local runs
# (e.g. through an SSM port-forward / bastion into the VPC).

AWS_REGION = cn-northwest-1
AGENT_CONFIG = default
MEMORY_FRAMEWORK = graphiti

# ---- OpenAI-compatible model gateway (LiteLLM proxy) -----------------------
LLM_BASE_URL = http://localhost:4000/v1
LLM_API_KEY = sk-...

# Aliases defined in litellm/config.yaml
GRAPHITI_LLM_MODEL = graphiti-llm
GRAPHITI_SMALL_MODEL = graphiti-small
AGENT_MODEL = agent-llm
EMBEDDING_MODEL = embedding
# Leave empty to disable the cross-encoder (default search uses RRF and doesn't need it)
RERANK_MODEL = rerank

# json_object: DeepSeek / Qwen / GLM / Kimi.  json_schema: only if every model behind
# graphiti-llm supports it.
LLM_STRUCTURED_OUTPUT_MODE = json_object
LLM_MAX_TOKENS = 8192

# MUST equal the native dimension of the model behind the "embedding" alias, and must
# not change after data is written (re-embed everything if you switch models).
#   DashScope text-embedding-v4 (dimensions: 1024) / bge-m3: 1024
EMBEDDING_DIM = 1024
EMBEDDING_BATCH_SIZE = 10

# ---- Neptune Database (Neptune Analytics is not available in China regions) ----
GRAPHITI_NEPTUNE_ENDPOINT = neptune-db://<cluster>.cluster-xxxx.cn-northwest-1.neptune.amazonaws.com.cn
GRAPHITI_NEPTUNE_PORT = 8182

# ---- OpenSearch managed domain (OpenSearch Serverless is not available in China) ----
GRAPHITI_OPENSEARCH_ENDPOINT = vpc-<domain>-xxxx.cn-northwest-1.es.amazonaws.com.cn
GRAPHITI_OPENSEARCH_SERVICE = es
# iam (SigV4, default) | basic (fine-grained access control master user)
GRAPHITI_OPENSEARCH_AUTH = iam
# GRAPHITI_OPENSEARCH_USERNAME =
# GRAPHITI_OPENSEARCH_PASSWORD =
